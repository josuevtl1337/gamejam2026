chart_data_lvl2 = json_parse(level2_json);

enum GameState
{
    COUNTDOWN,
    PLAYING,
    COMMENTARY,
    GAME_OVER,
    VICTORY
}


//State of Game
//game_state = "countdown";
//countdown = 3;
//countdown_timer = room_speed;
//music_started = false;
//level_finished = false;
//level_complete = false;

					
// SCORE BAR
//game_state = GameState.COUNTDOWN;
game_state = GameState.COUNTDOWN;

score_bar = 50;
score_bar_visual = 50;
score_bar_color = c_white;
score_bar_timer = 0;

level_complete = false;


countdown = 4;
countdown_timer = room_speed;

feedback_text = "";
feedback_timer = 0;

spawn_offset = 1.5;

song_started = false;

music_instance = noone;
chart_data_lvl1 = json_parse(level1_json);
chart_index = 0;

commentator_instance = noone;

current_level = 1;
levels = [
    {
        song: sound_lvl1,
        chart: chart_data_lvl1,
        target: 85,
        travel_time: 4,
		commentary:
        "¡La hinchada no para de alentar y su equipo se pone a la delantera!",
		available_keys: [
            vk_up,
            vk_down
        ],
    },

    {
        song: sound_lvl2,
        chart: chart_data_lvl2,
        target: 85,
        travel_time: 3,
		available_keys: [
            vk_up,
            vk_down,
            vk_left
        ],
		commentary:
        "¡La hinchada no para de alentar y su equipo se pone a la delantera!"
    },

    {
        song: chart_data_lvl1,
        chart: chart_data_lvl1,
        target: 85,
        travel_time: 2.5,
        final_level: true,
		available_keys: [
            vk_up,
            vk_down,
            vk_left,
            vk_right
        ],
			commentary:
        "¡La hinchada no para de alentar y su equipo se pone a la delantera!"
    }
];

function load_level()
{
    var data = levels[current_level];

    chart_index = 0;

    score_bar = 50;
    score_bar_visual = 50;

    level_complete = false;

    music_instance = noone;
	
	song_started = false;
	
    // Configuración del nivel
    current_song = data.song;
    current_chart = data.chart;
    current_target = data.target;
    current_travel_time = data.travel_time;
	current_commentary = data.commentary;
	current_available_keys = data.available_keys;
}

load_level();

function next_level()
{
	if (current_level >= array_length(levels) - 1)
    {
        game_state = GameState.VICTORY;
        return;
    }
	
    current_level++;

    load_level();

    countdown = 4;
    countdown_timer = room_speed;

    game_state = GameState.COUNTDOWN;

}

function commentator_finished()
{
    commentator_instance = noone;

    next_level();
}





